# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    COMFYUI_DISABLE_ANALYTICS=1

# 1. System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    git \
    curl \
    wget \
    aria2 \
    ffmpeg \
    tmux \
    jq \
    rsync \
    openssh-server \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. Hardened SSH for RunPod access (key auth only)
RUN mkdir -p /run/sshd && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?AllowTcpForwarding.*/AllowTcpForwarding yes/' /etc/ssh/sshd_config

# 3. PyTorch 2.6.0 + CUDA 12.4
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
      torch==2.6.0 torchvision torchaudio \
      --index-url https://download.pytorch.org/whl/cu124 && \
    python3 -m pip install \
      huggingface_hub[hf_transfer] \
      accelerate \
      transformers \
      safetensors \
      einops \
      opencv-python-headless \
      pillow \
      soundfile \
      scipy \
      "numpy<2"

# 4. Patch PyTorch 2.6 schema inference to support Python 3.10 typing (PEP 585/604)
RUN python3 -c "import torch, torch._library.infer_schema as s; \
path = s.__file__; \
code = '''\n# Add PEP 585 / 604 types support\nSUPPORTED_PARAM_TYPES.update({\n    list[int]: 'SymInt[]',\n    list[float]: 'float[]',\n    list[bool]: 'bool[]',\n    list[torch.Tensor]: 'Tensor[]',\n    torch.Tensor | None: 'Tensor?',\n    int | None: 'SymInt?',\n    float | None: 'float?',\n    str | None: 'str?',\n    bool | None: 'bool?',\n})\n'''; \
with open(path, 'r') as f: c = f.read(); \
c += code; \
with open(path, 'w') as f: f.write(c)"

# 5. Clone ComfyUI & install dependencies
WORKDIR /opt
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI && \
    cd /opt/ComfyUI && \
    python3 -m pip install -r requirements.txt

# 6. Install required custom nodes
WORKDIR /opt/ComfyUI/custom_nodes
RUN git clone --depth 1 https://github.com/kijai/ComfyUI-WanVideoWrapper.git && \
    git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    for req in */requirements.txt; do \
      if [ -f "$req" ]; then python3 -m pip install -r "$req" || true; fi; \
    done

# 7. Pre-cache public Wan 2.2 base weights (Strictly public base models, NO LoRAs)
WORKDIR /opt/ComfyUI
RUN mkdir -p models/diffusion_models models/clip models/vae models/loras && \
    hf_download() { \
      python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='$1', filename='$2', local_dir='/tmp/hf', local_dir_use_symlinks=False)"; \
    } && \
    # Wan 2.2 High-Noise 14B \
    hf_download "Comfy-Org/Wan_2.2_ComfyUI_Repackaged" "split_files/diffusion_models/wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors" && \
    mv /tmp/hf/split_files/diffusion_models/wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors models/diffusion_models/ && \
    # Wan 2.2 Low-Noise 14B \
    hf_download "Comfy-Org/Wan_2.2_ComfyUI_Repackaged" "split_files/diffusion_models/wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors" && \
    mv /tmp/hf/split_files/diffusion_models/wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors models/diffusion_models/ && \
    # Text Encoder (umt5) \
    hf_download "Comfy-Org/Wan_2.1_ComfyUI_repackaged" "split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors" && \
    mv /tmp/hf/split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors models/clip/ && \
    # VAE \
    hf_download "Comfy-Org/Wan_2.1_ComfyUI_repackaged" "split_files/vae/wan_2.1_vae.safetensors" && \
    mv /tmp/hf/split_files/vae/wan_2.1_vae.safetensors models/vae/ && \
    rm -rf /tmp/hf ~/.cache/huggingface

# Ensure models/loras is completely empty (no private weights baked)
RUN rm -rf /opt/ComfyUI/models/loras/* && touch /opt/ComfyUI/models/loras/put_loras_here

# 8. Copy entrypoint
COPY entrypoint-inference.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 8188

ENTRYPOINT ["/entrypoint.sh"]
